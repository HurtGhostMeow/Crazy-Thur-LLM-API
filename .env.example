# Use a new, high-entropy secret (at least 32 characters) for every deployment.
# Example PowerShell command:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
API_KEY_SECRET=replace-with-a-unique-long-random-secret

# Optional OpenAI-compatible upstream. Leave both URL and model empty to keep
# the original local random-copy mode. The API key may be empty for local models.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=1
LLM_CONTEXT_LENGTH=8192
LLM_MAX_OUTPUT_TOKENS=512
